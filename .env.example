# ---------------------------------------------------------------------------
# BrandOS – Umgebungsvariablen
# Kopiere diese Datei zu `.env.local`. Ohne Keys laeuft BrandOS vollstaendig
# im Mock-/Heuristik-Modus (alle Features nutzbar, Daten synthetisch).
# ---------------------------------------------------------------------------

# --- AI Layer --------------------------------------------------------------
# BrandOS deutet Marktdaten regelbasiert. Das ist die bewusste Voreinstellung,
# nicht ein Mangel:
#
#   - Der Opportunity Score entsteht ohnehin ohne Modell. Ein Modell erklaert
#     ihn, es berechnet ihn nicht.
#   - Solange ein grosser Teil der Signale synthetisch ist, wuerde ein Modell
#     diese Mock-Daten nur eloquenter interpretieren. Die Regelauswertung
#     klingt nicht klueger, als die Datenlage hergibt - das ist hier ein
#     Vorteil, kein Nachteil.
#
# Der modellgestuetzte Pfad bleibt jederzeit nachruestbar: ANTHROPIC_API_KEY
# eintragen und BRANDOS_AI_MODE auf "auto" stellen. Sinnvoll wird das, sobald
# die Signale ueberwiegend aus echten Quellen stammen.
#
# "auto"      - Modell nutzen, wenn ein Key vorliegt, sonst Heuristik
# "anthropic" - Modell erzwingen (scheitert ohne Key)
# "heuristic" - immer regelbasiert
BRANDOS_AI_MODE=heuristic

ANTHROPIC_API_KEY=
BRANDOS_AI_MODEL=claude-opus-5

# --- Data Provider ---------------------------------------------------------
# Jeder Provider meldet sich selbst als "verfuegbar", sobald sein Key gesetzt
# ist. Andernfalls uebernimmt der Mock-Provider derselben Quelle.
# Etsy braucht BEIDE Werte aus dem App-Dashboard. Die API erwartet sie in
# einem einzigen Header, durch Doppelpunkt getrennt (keystring:shared_secret);
# BrandOS setzt das selbst zusammen. Einzeln gesendet lehnt Etsy ab, und die
# Laenge ist kein Hinweis: Der Keystring hat 24 Zeichen, das Secret 10.
# Pruefen mit: node scripts/check-etsy-key.mjs
ETSY_API_KEY=
ETSY_API_SECRET=
PINTEREST_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SERPAPI_KEY=
RAPIDAPI_KEY=

# --- Runtime ---------------------------------------------------------------
# Speicherort des JSON-Datastores (Default: ./.data)
BRANDOS_DATA_DIR=
# Timeout pro Provider in ms
BRANDOS_PROVIDER_TIMEOUT_MS=8000
# Ablagedauer der Provider-Antworten in ms (Default: 12 h).
# 0 schaltet den Cache ab - nur zum Debuggen, jeder Abruf kostet dann
# echtes API-Kontingent.
BRANDOS_PROVIDER_CACHE_TTL_MS=43200000
# Gleichzeitige Abrufe je Live-Provider (Default: 3)
BRANDOS_PROVIDER_MAX_CONCURRENT=3
# debug | info | warn | error
BRANDOS_LOG_LEVEL=info
